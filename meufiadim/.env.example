# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Cloudinary (Configuração do SDK Node / Servidor e Servidores MCP)
# ⚠️ CLOUDINARY_API_SECRET nunca deve ser exposto ao navegador
CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
CLOUDINARY_API_KEY=sua_api_key_aqui
CLOUDINARY_API_SECRET=seu_api_secret_aqui

# Cloudinary Frontend (Next.js - seguro para expor no navegador)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=meufiadim_preset

# E-mail do dono da plataforma (acesso ao /superadmin)
NEXT_PUBLIC_SUPERADMIN_EMAIL=seu-email@gmail.com

# URL pública do app (necessária para o Webhook do Mercado Pago na Vercel)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# Mercado Pago (Credenciais de Produção)
MP_ACCESS_TOKEN=APP_USR-seu-token-aqui

# API Baileys (Oracle Cloud ou localhost)
ZAP_API_URL=http://localhost:3001
ZAP_API_KEY=minha-chave-secreta-meufiadim
